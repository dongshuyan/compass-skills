{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.skills.example/assess-interview-candidate/schema-interviewer-report.json",
  "title": "Simplified Interviewer Report Data",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case",
    "candidate_overview",
    "resume_risks",
    "interview_questions",
    "footer_note"
  ],
  "properties": {
    "schema_version": {"type": "string", "enum": ["1.0.0", "1.1.0"]},
    "case": {"$ref": "#/$defs/case"},
    "candidate_overview": {"$ref": "#/$defs/candidateOverview"},
    "resume_risks": {
      "type": "array",
      "maxItems": 8,
      "items": {"$ref": "#/$defs/resumeRisk"}
    },
    "interview_questions": {
      "type": "array",
      "minItems": 12,
      "maxItems": 18,
      "items": {"$ref": "#/$defs/interviewQuestion"}
    },
    "footer_note": {"$ref": "#/$defs/nonEmptyString"}
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {"const": "1.1.0"}
        }
      },
      "then": {
        "properties": {
          "candidate_overview": {
            "required": ["candidate_photo", "timeline_age_estimate"]
          }
        }
      },
      "else": {
        "properties": {
          "candidate_overview": {
            "allOf": [
              {"not": {"required": ["candidate_photo"]}},
              {"not": {"required": ["timeline_age_estimate"]}}
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "nonEmptyString": {"type": "string", "minLength": 1},
    "stringList": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/nonEmptyString"}
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "candidate_name", "role_title", "report_date", "blueprint_version", "human_review_status"],
      "properties": {
        "id": {"$ref": "#/$defs/nonEmptyString"},
        "candidate_name": {"$ref": "#/$defs/nonEmptyString"},
        "role_title": {"$ref": "#/$defs/nonEmptyString"},
        "report_date": {"type": "string", "format": "date"},
        "blueprint_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "human_review_status": {"$ref": "#/$defs/nonEmptyString"}
      }
    },
    "providedField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "source_status", "source_locator"],
      "properties": {
        "value": {"$ref": "#/$defs/nonEmptyString"},
        "source_status": {"enum": ["candidate_provided", "not_provided"]},
        "source_locator": {"type": ["string", "null"]}
      }
    },
    "age": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "display",
        "years",
        "approximate",
        "as_of",
        "normalized_birth",
        "precision",
        "source_status",
        "source_locator"
      ],
      "properties": {
        "display": {"$ref": "#/$defs/nonEmptyString"},
        "years": {"type": ["integer", "null"], "minimum": 0, "maximum": 130},
        "approximate": {"type": "boolean"},
        "as_of": {"type": "string", "format": "date"},
        "normalized_birth": {"type": ["string", "null"]},
        "precision": {"enum": ["day", "month", "year", "not_provided"]},
        "source_status": {"enum": ["candidate_provided", "not_provided"]},
        "source_locator": {"type": ["string", "null"]}
      }
    },
    "candidatePhoto": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "data_uri",
        "mime_type",
        "byte_length",
        "pixel_width",
        "pixel_height",
        "sha256",
        "provenance"
      ],
      "properties": {
        "status": {"enum": ["included", "not_present", "ambiguous", "extraction_unavailable"]},
        "data_uri": {"type": ["string", "null"]},
        "mime_type": {"enum": ["image/png", null]},
        "byte_length": {"type": ["integer", "null"], "minimum": 1},
        "pixel_width": {"type": ["integer", "null"], "minimum": 1},
        "pixel_height": {"type": ["integer", "null"], "minimum": 1},
        "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "provenance": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": [
            "source_kind",
            "source_document",
            "source_document_sha256",
            "page",
            "extraction_method",
            "image_index",
            "crop_box"
          ],
          "properties": {
            "source_kind": {"const": "resume_pdf"},
            "source_document": {"const": "input/resume-original.pdf"},
            "source_document_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "page": {"type": "integer", "minimum": 1},
            "extraction_method": {"enum": ["embedded_image", "page_crop", "not_completed"]},
            "image_index": {"type": ["integer", "null"], "minimum": 0},
            "crop_box": {
              "type": ["array", "null"],
              "minItems": 4,
              "maxItems": 4,
              "items": {"type": "integer", "minimum": 0}
            }
          }
        }
      }
    },
    "timelineAssumptions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "undergraduate_start_age_min",
        "undergraduate_start_age_typical",
        "undergraduate_start_age_max"
      ],
      "properties": {
        "undergraduate_start_age_min": {"const": 16},
        "undergraduate_start_age_typical": {"const": 18},
        "undergraduate_start_age_max": {"const": 20}
      }
    },
    "timelineConsistencyCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event", "date", "precision", "source_locator"],
      "properties": {
        "event": {"enum": ["undergraduate_graduation", "graduate_study_start", "employment_start", "other_later_event"]},
        "date": {"type": "string", "pattern": "^\\d{4}(?:-\\d{2}(?:-\\d{2})?)?$"},
        "precision": {"enum": ["year", "month", "day"]},
        "source_locator": {"$ref": "#/$defs/nonEmptyString"}
      }
    },
    "timelineAgeEstimate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "display",
        "as_of",
        "min_years",
        "max_years",
        "anchor",
        "assumptions",
        "consistency_status",
        "consistency_checks"
      ],
      "properties": {
        "status": {"enum": ["estimated", "not_needed", "insufficient_evidence", "timeline_conflict"]},
        "display": {"$ref": "#/$defs/nonEmptyString"},
        "as_of": {"type": "string", "format": "date"},
        "min_years": {"type": ["integer", "null"], "minimum": 0, "maximum": 130},
        "max_years": {"type": ["integer", "null"], "minimum": 0, "maximum": 130},
        "anchor": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": [
            "kind",
            "start",
            "precision",
            "source_locators",
            "graduation_date",
            "degree_duration_years"
          ],
          "properties": {
            "kind": {"enum": ["undergraduate_start", "undergraduate_start_derived_from_graduation_and_duration"]},
            "start": {"type": "string", "pattern": "^\\d{4}(?:-\\d{2}(?:-\\d{2})?)?$"},
            "precision": {"enum": ["year", "month", "day"]},
            "source_locators": {
              "type": "array",
              "minItems": 1,
              "items": {"$ref": "#/$defs/nonEmptyString"}
            },
            "graduation_date": {"type": ["string", "null"], "pattern": "^\\d{4}(?:-\\d{2}(?:-\\d{2})?)?$"},
            "degree_duration_years": {"type": ["integer", "null"], "minimum": 1, "maximum": 8}
          }
        },
        "assumptions": {"$ref": "#/$defs/timelineAssumptions"},
        "consistency_status": {"enum": ["not_checked", "consistent", "conflict", "not_assessable"]},
        "consistency_checks": {
          "type": "array",
          "maxItems": 12,
          "items": {"$ref": "#/$defs/timelineConsistencyCheck"}
        }
      }
    },
    "personalInfo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "birth_information",
        "age",
        "birthplace",
        "hometown",
        "marital_status",
        "current_city"
      ],
      "properties": {
        "birth_information": {"$ref": "#/$defs/providedField"},
        "age": {"$ref": "#/$defs/age"},
        "birthplace": {"$ref": "#/$defs/providedField"},
        "hometown": {"$ref": "#/$defs/providedField"},
        "marital_status": {"$ref": "#/$defs/providedField"},
        "current_city": {"$ref": "#/$defs/providedField"}
      }
    },
    "education": {
      "type": "object",
      "additionalProperties": false,
      "required": ["school", "degree_or_program", "period", "city", "city_source_status", "source_locator"],
      "properties": {
        "school": {"$ref": "#/$defs/nonEmptyString"},
        "degree_or_program": {"$ref": "#/$defs/nonEmptyString"},
        "period": {"$ref": "#/$defs/nonEmptyString"},
        "city": {"$ref": "#/$defs/nonEmptyString"},
        "city_source_status": {"enum": ["candidate_provided", "not_provided"]},
        "source_locator": {"$ref": "#/$defs/nonEmptyString"}
      }
    },
    "employment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["organization", "role", "period", "city", "city_source_status", "source_locator"],
      "properties": {
        "organization": {"$ref": "#/$defs/nonEmptyString"},
        "role": {"$ref": "#/$defs/nonEmptyString"},
        "period": {"$ref": "#/$defs/nonEmptyString"},
        "city": {"$ref": "#/$defs/nonEmptyString"},
        "city_source_status": {"enum": ["candidate_provided", "not_provided"]},
        "source_locator": {"$ref": "#/$defs/nonEmptyString"}
      }
    },
    "fitItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order", "capability", "status", "summary", "interview_focus"],
      "properties": {
        "order": {"type": "integer", "minimum": 1},
        "capability": {"$ref": "#/$defs/nonEmptyString"},
        "status": {"enum": ["match", "foundation_needs_confirmation", "evidence_insufficient"]},
        "summary": {"$ref": "#/$defs/nonEmptyString"},
        "interview_focus": {"$ref": "#/$defs/nonEmptyString"}
      }
    },
    "locationAndAvailability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["company_location", "distance_summary", "questions"],
      "properties": {
        "company_location": {"$ref": "#/$defs/nonEmptyString"},
        "distance_summary": {"$ref": "#/$defs/nonEmptyString"},
        "questions": {"$ref": "#/$defs/stringList"}
      }
    },
    "candidateOverview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "personal_info",
        "profile_summary",
        "education",
        "employment",
        "fit_items",
        "location_and_availability"
      ],
      "properties": {
        "personal_info": {"$ref": "#/$defs/personalInfo"},
        "candidate_photo": {"$ref": "#/$defs/candidatePhoto"},
        "timeline_age_estimate": {"$ref": "#/$defs/timelineAgeEstimate"},
        "profile_summary": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {"$ref": "#/$defs/nonEmptyString"}
        },
        "education": {
          "type": "array",
          "maxItems": 12,
          "items": {"$ref": "#/$defs/education"}
        },
        "employment": {
          "type": "array",
          "maxItems": 20,
          "items": {"$ref": "#/$defs/employment"}
        },
        "fit_items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {"$ref": "#/$defs/fitItem"}
        },
        "location_and_availability": {"$ref": "#/$defs/locationAndAvailability"}
      }
    },
    "resumeRisk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "order",
        "importance",
        "capability",
        "resume_excerpt",
        "unclear_point",
        "why_check",
        "how_to_verify"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/nonEmptyString"},
        "order": {"type": "integer", "minimum": 1},
        "importance": {"type": "integer", "minimum": 1, "maximum": 5},
        "capability": {"$ref": "#/$defs/nonEmptyString"},
        "resume_excerpt": {"$ref": "#/$defs/nonEmptyString"},
        "unclear_point": {"$ref": "#/$defs/nonEmptyString"},
        "why_check": {"$ref": "#/$defs/nonEmptyString"},
        "how_to_verify": {"$ref": "#/$defs/nonEmptyString"}
      }
    },
    "interviewQuestion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "order", "priority", "kind", "question", "purpose", "evaluation_mode"],
      "properties": {
        "id": {"$ref": "#/$defs/nonEmptyString"},
        "order": {"type": "integer", "minimum": 1},
        "priority": {"enum": ["must_ask", "recommended", "optional"]},
        "kind": {"enum": ["job_core", "work_sample", "resume_check", "soft_skill", "logistics", "candidate_choice"]},
        "question": {"$ref": "#/$defs/nonEmptyString"},
        "purpose": {"$ref": "#/$defs/nonEmptyString"},
        "evaluation_mode": {"enum": ["rated", "record_only"]},
        "good_answer": {"$ref": "#/$defs/nonEmptyString"},
        "average_answer": {"$ref": "#/$defs/nonEmptyString"},
        "poor_answer": {"$ref": "#/$defs/nonEmptyString"},
        "bonus_signals": {"$ref": "#/$defs/stringList"},
        "penalty_signals": {"$ref": "#/$defs/stringList"},
        "recording_guidance": {"$ref": "#/$defs/nonEmptyString"}
      }
    }
  }
}
