{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.skills.example/assess-interview-candidate/schema-job-model.json",
  "title": "Candidate Assessment Job Model",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "case_id", "status", "role", "capabilities"],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "case_id": {"$ref": "#/$defs/nonEmptyString"},
    "status": {"enum": ["provisional", "sme_confirmed", "superseded"]},
    "research_cutoff": {"type": ["string", "null"], "format": "date"},
    "role": {"$ref": "#/$defs/role"},
    "work_outputs": {
      "type": "array",
      "items": {"$ref": "#/$defs/workOutput"},
      "default": []
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/capability"}
    },
    "assumptions": {
      "type": "array",
      "items": {"$ref": "#/$defs/nonEmptyString"},
      "default": []
    },
    "metadata": {"type": "object", "additionalProperties": true}
  },
  "$defs": {
    "nonEmptyString": {"type": "string", "minLength": 1},
    "role": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "level", "family"],
      "properties": {
        "title": {"$ref": "#/$defs/nonEmptyString"},
        "level": {"$ref": "#/$defs/nonEmptyString"},
        "family": {"$ref": "#/$defs/nonEmptyString"},
        "organization": {"type": ["string", "null"]},
        "location": {"type": ["string", "null"]},
        "adapter": {"type": ["string", "null"]}
      }
    },
    "workOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "observable_result"],
      "properties": {
        "id": {"$ref": "#/$defs/nonEmptyString"},
        "name": {"$ref": "#/$defs/nonEmptyString"},
        "observable_result": {"$ref": "#/$defs/nonEmptyString"},
        "constraints": {"type": "array", "items": {"$ref": "#/$defs/nonEmptyString"}},
        "source_ids": {"type": "array", "items": {"$ref": "#/$defs/nonEmptyString"}}
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "action", "object", "observable_result"],
      "properties": {
        "id": {"$ref": "#/$defs/nonEmptyString"},
        "action": {"$ref": "#/$defs/nonEmptyString"},
        "object": {"$ref": "#/$defs/nonEmptyString"},
        "context": {"type": ["string", "null"]},
        "observable_result": {"$ref": "#/$defs/nonEmptyString"},
        "output_ids": {"type": "array", "items": {"$ref": "#/$defs/nonEmptyString"}}
      }
    },
    "rating": {
      "type": ["integer", "null"],
      "minimum": 1,
      "maximum": 5,
      "description": "Use null when the rating is not known or not yet confirmed."
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "name", "definition", "tier", "target_level", "entry_requirement",
        "tasks", "observable_behaviors", "acceptable_evidence", "assessment_methods",
        "importance", "frequency", "failure_impact", "weight", "sme_confirmed"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/nonEmptyString"},
        "name": {"$ref": "#/$defs/nonEmptyString"},
        "definition": {"$ref": "#/$defs/nonEmptyString"},
        "tier": {"enum": ["gate", "critical", "supporting", "differentiator"]},
        "target_level": {"$ref": "#/$defs/nonEmptyString"},
        "entry_requirement": {"enum": ["required_on_entry", "learnable_on_job", "bonus", "unknown"]},
        "tasks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/task"}},
        "observable_behaviors": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonEmptyString"}},
        "acceptable_evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonEmptyString"}},
        "assessment_methods": {
          "type": "array",
          "minItems": 1,
          "items": {"enum": ["resume_evidence", "structured_interview", "work_sample", "job_knowledge", "reference_check", "other"]}
        },
        "importance": {"$ref": "#/$defs/rating"},
        "frequency": {"$ref": "#/$defs/rating"},
        "failure_impact": {"$ref": "#/$defs/rating"},
        "weight": {"type": "number", "exclusiveMinimum": 0},
        "source_ids": {"type": "array", "items": {"$ref": "#/$defs/nonEmptyString"}},
        "sme_confirmed": {"type": "boolean"},
        "notes": {"type": ["string", "null"]}
      }
    }
  }
}
